# 🏰 Asgard — Build & Push asgard-portal image to ghcr.io
#
# After Sprint 51d polyrepo migration: Asgard repo only owns asgard-portal
# (source lives at packages/asgard-portal/). All other services build in
# their own repos via .github/workflows/build.yml. See CONTRIBUTING.md
# branching/CI section + the open-core journey blog post for context.
#
# History:
# - PR #17: multi-arch QEMU
# - PR #18: add asgard-portal to matrix
# - PR #19/22/23: split-arch experiment (reverted — keychain issues on self-hosted)
# - PR #24: bifrost cross-repo workaround
# - PR #25/26: governance + ci-success
# - PR #27: forseti+vardr removed (first polyrepo migration)
# - This PR: 8 more services removed → matrix has only asgard-portal

name: Build and Push

on:
  push:
    branches: [main]
    paths:
      - 'packages/asgard-portal/**'
      - 'charts/**'
      - 'k8s/**'
      - 'docker-compose.yml'
  workflow_dispatch:

env:
  REGISTRY: ghcr.io
  ORG: megawiz-dev-team
  IMAGE: asgard-portal

jobs:
  build:
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
    steps:
      - uses: actions/checkout@v4

      - uses: docker/setup-qemu-action@v3
        with:
          platforms: arm64

      - uses: docker/setup-buildx-action@v3

      - uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Build and Push (multi-arch)
        uses: docker/build-push-action@v6
        with:
          context: ./packages/asgard-portal
          file: ./packages/asgard-portal/Dockerfile
          push: true
          platforms: linux/amd64,linux/arm64
          tags: |
            ${{ env.REGISTRY }}/${{ env.ORG }}/${{ env.IMAGE }}:${{ github.sha }}
            ${{ env.REGISTRY }}/${{ env.ORG }}/${{ env.IMAGE }}:latest
          cache-from: type=gha
          cache-to: type=gha,mode=max

  ci-success:
    needs: build
    if: always()
    runs-on: ubuntu-latest
    steps:
      - run: |
          if [ "${{ needs.build.result }}" != "success" ]; then
            echo "❌ build failed: ${{ needs.build.result }}"; exit 1
          fi
          echo "✅ build passed"
