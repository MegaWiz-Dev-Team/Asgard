# ╔══════════════════════════════════════════════════════════════╗
# ║  🏰 ASGARD — Centralized Environment Variables             ║
# ║  Single source of truth for ALL services                    ║
# ╚══════════════════════════════════════════════════════════════╝
# Usage:
#   - Docker Compose reads this automatically
#   - Heimdall (host): source scripts/env-export.sh
#   - NEVER commit this file (included in .gitignore)

# ═══════════════════════════════════════
# 💾 INFRASTRUCTURE — Databases
# ═══════════════════════════════════════

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=mimir
MYSQL_USER=mimir
MYSQL_PASSWORD=REDACTED-PW

POSTGRES_PASSWORD=REDACTED-PW
NEO4J_PASSWORD=REDACTED-PW

# ═══════════════════════════════════════
# 🛡️ HEIMDALL — LLM Gateway (on host)
# ═══════════════════════════════════════

HEIMDALL_PORT=8080
HEIMDALL_API_KEY=hml-REDACTED
HEIMDALL_MODEL=mlx-community/Qwen3.5-9B-MLX-4bit
HEIMDALL_BACKEND_ENGINE=mlx
HEIMDALL_BACKEND_PORT=8081
HEIMDALL_GATEWAY_PORT=8080

# ═══════════════════════════════════════
# 🧠 EMBEDDING — MLX Embedding Server
# ═══════════════════════════════════════

EMBEDDING_PORT=8001
EMBEDDING_HOST=127.0.0.1
EMBEDDING_MODEL=BAAI/bge-m3

# ═══════════════════════════════════════
# 🧠 MIMIR — Knowledge Platform
# ═══════════════════════════════════════

MIMIR_API_PORT=3000
MIMIR_DASHBOARD_PORT=3001
MIMIR_EMBED_MODEL=nomic-embed-text
MIMIR_CRON_TICK_SECONDS=60

# ═══════════════════════════════════════
# 🔑 SHARED AUTH — JWT & API Keys
# ═══════════════════════════════════════

JWT_SECRET=JWT_REDACTED

# ═══════════════════════════════════════
# 🤖 EXTERNAL AI — Gemini
# ═══════════════════════════════════════

GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_API_KEY=AIza-REDACTED
GEMINI_MODEL=gemini-3-flash-preview

# ═══════════════════════════════════════
# 📦 S3 / Object Storage
# ═══════════════════════════════════════

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=mimir-uploads
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# ═══════════════════════════════════════
# 🔐 VAULT (future use)
# ═══════════════════════════════════════

VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=hvs-REDACTED
VAULT_MOUNT=secret
VAULT_PATH=mimir/secrets

# ═══════════════════════════════════════
# 🌳 YGGDRASIL — Auth (powered by Zitadel)
# ═══════════════════════════════════════

YGGDRASIL_PORT=8085
YGGDRASIL_EXTERNALDOMAIN=localhost
YGGDRASIL_MASTERKEY=yggdrasil-masterkey-change-me-ok
YGGDRASIL_ADMIN_EMAIL=paripol@megawiz.co
YGGDRASIL_ADMIN_PASSWORD=REDACTED-PW

# 📧 SMTP (Vardr) — Google App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=paripol@megawiz.co
SMTP_PASSWORD=anwg yxrh nnmw aadt

# 🔐 OIDC (Mimir Dashboard)
YGGDRASIL_CLIENT_ID=364176713539715075
YGGDRASIL_CLIENT_SECRET=YGGDRASIL_SECRET_REDACTED
YGGDRASIL_ISSUER=http://localhost:8085


# ═══════════════════════════════════════
# ⚡ BIFROST — Agent Runtime
# ═══════════════════════════════════════

BIFROST_PORT=8100
BIFROST_DEFAULT_MODEL=qwen3.5
BIFROST_MAX_ITERATIONS=10
BIFROST_MAX_EXECUTION_TIME=120

# ═══════════════════════════════════════
# 🐺 FENRIR — Computer-Use Agent
# ═══════════════════════════════════════

FENRIR_PORT=8200
FENRIR_BROWSER_HEADLESS=true

# ═══════════════════════════════════════
# 🏥 EIR / OpenEMR (--profile full)
# ═══════════════════════════════════════

OPENEMR_PORT=80
OPENEMR_MYSQL_PASSWORD=openemr
OPENEMR_ADMIN_PASSWORD=pass

# ═══════════════════════════════════════
# ⚙️ GENERAL
# ═══════════════════════════════════════

LOG_LEVEL=info
RUST_LOG=info

# ═══════════════════════════════════════
# 📁 STORAGE (host paths)
# ═══════════════════════════════════════

EXTERNAL_MODEL_DIR="/Volumes/T7 Shield/Development/AI_Models"
